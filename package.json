{
  "name": "phone-mcp-by-narihito",
  "version": "1.0.0",
  "description": "MCP server to control an Android phone from AI tools over Wi-Fi or USB, with one-command setup",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "phone-mcp": "dist/index.js",
    "phone-mcp-by-narihito": "dist/index.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.js",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "prepublishOnly": "npm test",
    "setup": "node dist/index.js setup",
    "pair": "node dist/index.js pair",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "test": "tsc && node --test dist/**/*.test.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/index.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "android",
    "adb",
    "phone",
    "claude",
    "cursor",
    "ai-agent"
  ],
  "author": "NarihitoM",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NarihitoM/PhoneMCP.git"
  },
  "homepage": "https://github.com/NarihitoM/PhoneMCP#readme",
  "bugs": {
    "url": "https://github.com/NarihitoM/PhoneMCP/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
